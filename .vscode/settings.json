{
  "java.import.gradle.enabled": false,
  "java.project.resourceFilters": [
    "node_modules",
    ".git",
    "mobile",
    "admin-dashboard"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/mobile/node_modules/**": true,
    "**/admin-dashboard/node_modules/**": true,
    "**/backend/target/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/backend/target": true
  }
}
